# Flask Application Configuration
SECRET_KEY=upi-fraud-ai-secret-key-secure-2026
FLASK_ENV=development
DEBUG=True
PORT=5000

# Database Configuration
# Primary: MySQL (e.g. MySQL 8.0 / XAMPP)
DB_TYPE=mysql
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=root
DB_NAME=upi_fraud_db

# Fallback SQLite path if MySQL is offline or credentials differ
SQLITE_DB_PATH=upi_fraud.db

# Risk Scoring Engine Thresholds (0 - 100)
# Score < RISK_THRESHOLD_LOW = LOW RISK
# RISK_THRESHOLD_LOW <= Score < RISK_THRESHOLD_HIGH = MEDIUM RISK
# Score >= RISK_THRESHOLD_HIGH = HIGH RISK (Auto Blocked)
RISK_THRESHOLD_LOW=35
RISK_THRESHOLD_HIGH=70
AUTO_BLOCK_HIGH_RISK=true

# Uploads Configuration
MAX_CONTENT_LENGTH=16777216
UPLOAD_FOLDER=uploads
